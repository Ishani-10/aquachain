{
  "name": "aquachain-ledger",
  "version": "1.0.0",
  "description": "AquaChain - DeSci Blockchain Platform for Blue Carbon Registry and MRV (Monitoring, Reporting & Verification) of Coastal Ecosystem Restoration Projects",
  "private": true,
  "workspaces": [
    "packages/hardhat",
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspace @carbon-registry/frontend build",
    "dev": "yarn workspace @carbon-registry/frontend dev",
    "hardhat": "yarn workspace @aquachain/hardhat hardhat",
    "deploy": "yarn workspace @aquachain/hardhat deploy",
    "test": "yarn workspace @aquachain/hardhat test",
    "lint": "yarn workspace @carbon-registry/frontend lint",
    "start": "yarn workspace @carbon-registry/frontend start",
    "chain": "yarn workspace @aquachain/hardhat chain",
    "compile": "yarn workspace @aquachain/hardhat compile"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ishani-10/aquachain"
  },
  "keywords": [
    "blockchain",
    "blue-carbon",
    "carbon-credits",
    "mrv",
    "coastal-restoration",
    "polygon",
    "smart-contracts"
  ],
  "author": "ISHANI GUPTA",
  "license": "MIT",
  "devDependencies": {
    "husky": "^8.0.3",
    "lint-staged": "^13.2.2"
  },
  "dependencies": {
    "daisyui": "^5.1.27"
  }
}
